# ═══════════════════════════════════════════════
# Media Tools Frontend — Environment Variables
# ═══════════════════════════════════════════════

# Production builds take NO auth variables. The web app signs in with first-party
# cookie sessions through the same-origin /api proxy (netlify.toml), and
# VITE_API_URL, VITE_CLERK_PUBLISHABLE_KEY and VITE_WEB_COOKIE_AUTH_ENABLED are
# no longer read. VITE_* values are public in the browser bundle: never add a
# secret, AI key, database URL, JWT secret, or admin key here.

# Local development only (ignored by production builds): run without an account
# using an API key stored in the browser. Vite proxies /api, so VITE_API_URL is
# only needed to point at a different API host.
# VITE_LOCAL_API_KEY_MODE=true
# VITE_API_URL=
