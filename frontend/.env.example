# ═══════════════════════════════════════════════
# Media Tools Frontend — Environment Variables
# ═══════════════════════════════════════════════

# API URL (leave empty in development, Vite proxy handles it)
# In production (Netlify), set this to your Render backend URL:
# VITE_API_URL=https://media-tools-api.onrender.com
VITE_API_URL=

# Staged browser session migration. Requires FIRST_PARTY_AUTH_ENABLED and
# WEB_COOKIE_AUTH_ENABLED on the API, plus the same-origin /api proxy above.
# Leave VITE_API_URL empty when this is true.
VITE_WEB_COOKIE_AUTH_ENABLED=false

# Clerk Authentication (required for production)
# Get your publishable key from: https://dashboard.clerk.com
# VITE_* values are public in the browser bundle. Never add a Clerk secret key,
# AI key, database URL, JWT secret, or admin key here.
VITE_CLERK_PUBLISHABLE_KEY=
