<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Standard bundle metadata is explicit because this target uses a custom
         Info.plist (GENERATE_INFOPLIST_FILE = NO). Omitting these values allows
         compilation to succeed but produces an app that the simulator cannot
         install. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Media Tools</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Keep an explicitly initiated recording alive when the screen locks or
         the user moves to another app. The audio session is deactivated as
         soon as capture stops, so this mode is used only for its stated role. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- Microphone access for audio recording -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Media Tools needs microphone access to record audio for transcription.</string>

    <!-- Configuration values (can be overridden via xcconfig) -->
    <key>CLERK_PUBLISHABLE_KEY</key>
    <string>$(CLERK_PUBLISHABLE_KEY)</string>
    <key>API_BASE_URL</key>
    <string>$(API_BASE_URL)</string>

    <!-- App Transport Security (allow localhost in dev) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
