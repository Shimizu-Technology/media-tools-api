<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Standard bundle metadata is explicit because this target uses a custom
         Info.plist (GENERATE_INFOPLIST_FILE = NO). Omitting these values allows
         compilation to succeed but produces an app that the simulator cannot
         install. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Media Tools</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- Keep an explicitly initiated recording alive when the screen locks or
         the user moves to another app. The audio session is deactivated as
         soon as capture stops, so this mode is used only for its stated role. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- Microphone access for audio recording -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Media Tools uses the microphone only after you start a recording, so it can save the audio on this iPhone and transcribe it in your private workspace.</string>

    <!-- Required for the visible recording status and controls that accompany
         an AudioRecordingIntent started from the Action Button or Shortcuts. -->
    <key>NSSupportsLiveActivities</key>
    <true/>

    <!-- Declaring a modern launch screen prevents compatibility-mode
         letterboxing on current iPhone and iPad displays. -->
    <key>UILaunchScreen</key>
    <dict/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Tapping the Live Activity returns directly to the Record tab. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.ShimizuTechnology.MediaTools</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>mediatools</string>
            </array>
        </dict>
    </array>

    <!-- Configuration values (can be overridden via xcconfig) -->
    <key>CLERK_PUBLISHABLE_KEY</key>
    <string>$(CLERK_PUBLISHABLE_KEY)</string>
    <key>API_BASE_URL</key>
    <string>$(API_BASE_URL)</string>

    <!-- App Transport Security (allow localhost in dev) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
