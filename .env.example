# ═══════════════════════════════════════════════
# Media Tools API — Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════

# Server
PORT=8080
GIN_MODE=debug            # debug, release, test

# Database (PostgreSQL)
# DATABASE_URL can be pooled or direct. For production, prefer DIRECT to avoid PgBouncer issues.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/media_tools?sslmode=disable
# Optional direct (non-pooled) connection string for production
DATABASE_URL_DIRECT=

# YouTube transcript extraction
YT_DLP_PATH=              # Leave empty to auto-detect, or set path explicitly
# Optional: cookies file for login-required/private videos (e.g., Vimeo private links)
# Must be Netscape cookies.txt format (exported from a logged-in browser session).
YT_DLP_COOKIES_FILE=
# Optional alternative for platforms without secret files:
# Base64-encoded contents of cookies.txt (server writes to /tmp at startup).
YT_DLP_COOKIES_B64=

# YouTube Proxy (REQUIRED for cloud hosting)
# YouTube blocks datacenter IPs. Use a residential proxy service like Webshare.
# Format: http://username:password@proxy.host.com:port
# Get rotating residential proxies at: https://www.webshare.io/ (~$5-10/month)
YOUTUBE_PROXY=

# OpenRouter AI (for summaries)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-4.5-sonnet-20250929    # Quality-oriented summary model
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash            # Low-latency interactive chat model
OPENROUTER_PROVIDER_SORT=throughput                      # throughput, latency, price, or blank

# OpenAI (Whisper/API for audio transcription and AI summary fallback)
OPENAI_API_KEY=
# Used automatically when OpenRouter rejects a summary/chat request because of
# billing, authentication, rate limiting, or temporary provider availability.
OPENAI_SUMMARY_FALLBACK_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Default to English to avoid Whisper language auto-detection hallucinations on meetings.
# Set to "auto" only if you need multi-language detection.
OPENAI_TRANSCRIPTION_LANGUAGE=en
# Optional prompt/context for unusual vocabulary. Leave blank for safest general transcription.
OPENAI_TRANSCRIPTION_PROMPT=
# Model used only to add capitalization, punctuation, and paragraph breaks.
# Every response is rejected unless it preserves the exact spoken word sequence.
OPENAI_TRANSCRIPT_FORMAT_MODEL=gpt-4.1-mini
# Max audio upload size is currently 2GB in-app.

# AWS S3 (Audio Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=
AWS_REGION=
AWS_S3_PREFIX=audio
AUDIO_PLAYBACK_URL_EXPIRY_MINUTES=60

# JWT Authentication (MTA-20)
# Local placeholder only. Release mode requires an independent 32+ character value.
JWT_SECRET=your-secret-key-change-me
# First-party device sessions and browser cookies.
FIRST_PARTY_AUTH_ENABLED=false
# Uses Argon2id password hashes and the same rotating opaque sessions as
FIRST_PARTY_PASSWORD_AUTH_ENABLED=false
WEB_COOKIE_AUTH_ENABLED=false
# Admin API Key (for creating API keys)
# In production, this is REQUIRED and must be at least 32 characters.
# Use: curl -H "X-Admin-Key: your-admin-key" -X POST /api/v1/keys ...
ADMIN_API_KEY=

# Owner override (optional)
# Use this to bypass rate limits and queue caps for your personal key.
# Recommended: set OWNER_API_KEY_ID to the key's UUID from GET /api/v1/keys
# Legacy queue/rate-limit override only; prefixes NEVER exempt monthly usage or model policy.
OWNER_API_KEY_ID=
OWNER_API_KEY_PREFIX=

# Worker pool
WORKER_COUNT=3            # Number of background workers
JOB_QUEUE_SIZE=100        # In-process worker wake buffer; durable queue lives in PostgreSQL
WHISPER_CHUNK_CONCURRENCY=3
WHISPER_GLOBAL_CONCURRENCY=6

# Rate limiting
DEFAULT_RATE_LIMIT=100                 # Requests/hour per API key and per browser-user mutation bucket
DEFAULT_BROWSER_READ_RATE_LIMIT=10000  # GET/HEAD requests/hour per signed-in browser user

# CORS
CORS_ORIGIN=http://localhost:5173     # comma-separated frontend origins (in prod: https://your-app.example)

# ═══════════════════════════════════════════════
# PRODUCTION DEPLOYMENT NOTES
# ═══════════════════════════════════════════════
# 
# Render (Backend):
#   - GIN_MODE=release
#   - DATABASE_URL=postgres://...@neon.tech/...?sslmode=require
#   - CORS_ORIGIN=https://your-app.netlify.app
#   - JWT_SECRET=(generate secure key: openssl rand -base64 32)
#   - ADMIN_API_KEY=(generate secure key: openssl rand -base64 32)
#   - YOUTUBE_PROXY=http://user:pass@proxy.webshare.io:port (REQUIRED for YouTube)
#   - YT_DLP_COOKIES_FILE=/etc/secrets/vimeo-cookies.txt (for Vimeo private/login-required links)
#   - OR YT_DLP_COOKIES_B64=(base64 cookies.txt for platforms that only support env vars)
#
# Netlify (Frontend):
#   - No auth variables: the web app uses same-origin cookie sessions through the
#     VITE_WEB_COOKIE_AUTH_ENABLED are no longer read and can be deleted.
#   - NEVER put server, AI, database, AWS, JWT, or admin secrets in VITE_* variables
#
# Neon (Database):
#   - Use the direct (non-pooled) connection string to avoid PgBouncer prepared statement issues
#   - Ensure ?sslmode=require in DATABASE_URL_DIRECT
#
# YouTube Proxy (CRITICAL):
#   YouTube blocks all datacenter IPs (AWS, Render, Railway, etc.).
#   You MUST use a residential proxy for YouTube extraction to work.
#   Recommended: Webshare.io rotating residential proxies (~$5-10/month)
#   1. Sign up at https://www.webshare.io/
#   2. Get "Rotating Residential" proxies
#   3. Set YOUTUBE_PROXY=http://username:password@p.webshare.io:80

# Inexpensive automatic recording title model (summary uses OPENROUTER_MODEL).
OPENROUTER_TITLE_MODEL=google/gemini-2.5-flash-lite
# Enable after all worker instances run the pipeline upgrade.
AUTOMATIC_AUDIO_ENRICHMENT_ENABLED=false
# Email proof and public registration (safe before production configuration)
EMAIL_DELIVERY=log                    # log suppresses mail; never prints codes or addresses
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PUBLIC_SIGNUP_ENABLED=false           # requires first-party password auth
# Opt-in only on Render's PUBLIC web-service edge; trusts overwritten CF-Connecting-IP.
RENDER_CLIENT_IP_ENABLED=false
# Same secret on Render and Netlify (Runtime scope); verifies signed proxy JWT.
# Never put it in a VITE_* variable. Empty fails safe (Netlify IP is untrusted).
NETLIFY_PROXY_SIGNATURE_SECRET=
# Other explicitly verified socket proxies only. Never use 0.0.0.0/0 or ::/0.
# With no verified source, skip shared-IP auth throttles; account limits remain.
TRUSTED_PROXY_CIDRS=
DEFAULT_MONTHLY_TRANSCRIPTION_MINUTES=300
DEFAULT_MONTHLY_AI_REQUESTS=1000        # all AI text work, including formatting/title/summary/chat
OWNER_USER_ID=                         # immutable users.id, optional owner exemption
